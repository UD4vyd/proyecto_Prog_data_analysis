# Copy to .env and fill in. Never commit .env.

# NWS API requires a descriptive User-Agent with a contact (email or URL).
NWS_USER_AGENT="Team5-ExtremeWeatherMonitor/0.1 (contact: your-email@example.com)"

# Database (Workshop 2, Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=extreme_weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me

# Optional: NOAA CDO web services token (not needed for the Access Data Service)
NCEI_CDO_TOKEN=
