# Copy this file to .env and fill the values. .env is not committed.

# Contact sent to api.weather.gov in the User-Agent header (the NWS API requires one).
NWS_USER_AGENT="(extreme-weather-monitoring, your-email@example.com)"

# Airflow. Generate the Fernet key with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
AIRFLOW_JWT_SECRET=change_me
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# On Linux set this to the output of `id -u`. On Windows and macOS keep 50000.
AIRFLOW_UID=50000
